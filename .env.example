# Google Maps JavaScript API key (used in the browser; restrict by API and HTTP referrer)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Server-side Gemini API key (optional)
GEMINI_API_KEY=

# Stripe Checkout embedded form — sandbox credentials (never commit secret values)
# Publishable key is safe for the browser; secret key is server-only.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Only set to true after shipping, tax, fulfillment and live review are complete.
STRIPE_ENABLE_LIVE_PAYMENTS=

# Stripe one-time EUR Price IDs for the two A2 products.
# Both Greek gallery variants share one product price.
STRIPE_PRICE_GREEK_THEOGONY=
STRIPE_PRICE_TRANSIT_THEOGONY_RING=

# Used for Stripe's post-payment return URL; set for production and Vercel previews.
NEXT_PUBLIC_SITE_URL=
